{
	"extraKnownMarketplaces": {
		"benweese": {
			"source": {
				"source": "github",
				"repo": "benweese/claude-plugins"
			}
		}
	},
	"enabledPlugins": {
		"qa@benweese": true,
		"workflow@benweese": true,
		"docs@benweese": true
	},
	"permissions": {
		"allow": [
			"Bash(npx playwright test:*)",
			"Bash(npm test:*)",
			"Bash(npm run test:*)",
			"Bash(npm run lint:*)",
			"Bash(npx eslint:*)",
			"Bash(npx playwright-cli:*)",
			"Bash(npx playwright show-report:*)"
		]
	}
}
