{
	"name": "playwright-e2e-demo",
	"private": true,
	"type": "module",
	"description": "Playwright API and UI test suite for automationexercise.com, built on playwright-test-commons and written with the playwright-qa-agents Claude Code plugin.",
	"author": "Ben Weese",
	"license": "MIT",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"test": "playwright test",
		"test:smoke": "playwright test --project=smoke",
		"test:api": "playwright test --project=api",
		"test:ui": "playwright test --project=ui",
		"report": "playwright show-report",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write ."
	},
	"dependencies": {
		"@benweese/playwright-test-commons": "https://github.com/benweese/playwright-test-commons/archive/refs/tags/v0.1.0.tar.gz",
		"dayjs": "^1.11.23"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@faker-js/faker": "^10.6.0",
		"@playwright/cli": "^0.1.23",
		"@playwright/test": "^1.65.0",
		"dotenv": "^18.0.9",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-playwright": "^2.12.2",
		"globals": "^17.14.0",
		"prettier": "^3.9.10"
	}
}
