{
	"name": "playwright-e2e-demo",
	"private": true,
	"type": "module",
	"description": "Playwright API and UI test suite for automationexercise.com, built on playwright-test-commons and written with the playwright-qa-agents Claude Code plugin.",
	"author": "Ben Weese",
	"license": "MIT",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"test": "playwright test",
		"test:smoke": "playwright test --project=smoke",
		"test:api": "playwright test --project=api",
		"test:ui": "playwright test --project=ui",
		"report": "playwright show-report",
		"lint": "eslint . && tsc && npm run check:ids",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"check:ids": "node scripts/check-test-ids.ts",
		"typecheck": "tsc",
		"skills:update": "playwright-cli install --skills"
	},
	"dependencies": {
		"@benweese/playwright-test-commons": "github:benweese/playwright-test-commons#v0.3.0",
		"dayjs": "^1.11.23"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@faker-js/faker": "^10.6.0",
		"@playwright/cli": "^0.1.24",
		"@playwright/test": "^1.65.0",
		"@types/node": "^26.6.6",
		"dotenv": "^18.0.10",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-playwright": "^2.12.2",
		"globals": "^17.14.0",
		"playwright": "^1.65.0",
		"prettier": "^3.9.10",
		"typescript": "~6.0",
		"typescript-eslint": "^8.72.2"
	}
}
