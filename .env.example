# Copy to .env (git-ignored). Never commit real values.
# Only "prod" exists for automationexercise.com, and it is the default.
# TEST_ENV=prod
# Override the configured URLs for one run:
# BASE_URL=https://automationexercise.com
# API_BASE_URL=https://automationexercise.com/api
# Log request/response bodies (local debugging only):
# DEBUG_API=true
# Regenerate JSON schemas from live responses (review the diff, then turn off):
# UPDATE_SCHEMAS=true
